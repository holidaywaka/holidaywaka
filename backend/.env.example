# Holidaywaka API - environment variables
# Copy to .env and fill in. Never commit real values.

# ------------------------------------------------------------------ Server
PORT=8002
# "development" uses dev behaviour (Swagger on, local defaults); anything else is treated as production
ENVIRONMENT=development
# Public URL of the website: links in emails (receipts, hotel booking page, upload payment slip)
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
# Production only: set to "true" to expose /api-docs (always on in development)
SWAGGER_ENABLED=false

# ------------------------------------------------------------------ Database (MySQL)
DB_HOST=localhost
DB_NAME=holidaywaka
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# ------------------------------------------------------------------ Cloudinary (images, payment slips)
CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

# ------------------------------------------------------------------ Email (SMTP over SSL, port 465)
# MAIL_NAME is the sender name; MAIL_USER is the sender address and the support address shown in emails
MAIL_NAME=Holidaywaka
MAIL_HOST=smtp.example.com
MAIL_USER=info@holidaywaka.com
MAIL_PASSWORD=
# Scripts/tests only: "true" runs the payment and booking flows without sending any email
DISABLE_TRANSACTION_MAIL=false

# ------------------------------------------------------------------ Unified Payment / Payloft (card payments)
# Generic Merchant Integration API v1.1, one host for everything:
#   create order  POST {UP_URL}/api/transaction/initialize/{UP_MERCHANT_ID}
#   payment page  {UP_URL}/{token}
#   status        GET  {UP_URL}/api/transaction/gettransactionstatus/{token}
# sk_test_ keys create sandbox orders on the same host
UP_URL=https://pay.mypayloft.com
# From Payloft: Settings > API Keys. The secret key also verifies webhooks (x-api-key / X-Payloft-Signature)
UP_MERCHANT_ID=
UP_SECRET_KEY=
# Our webhook endpoint, registered as callbackUrl on every order
UP_CALLBACK_URL=https://apidev.holidaywaka.com/api/transactions/webhook
# Website base the customer returns to after paying (verify-payment page is appended)
UP_RETURN_URL=https://dev.holidaywaka.com

# ------------------------------------------------------------------ iWay (airport transfers / chauffeur)
IWAY_URI=
IWAY_USER_ID=
IWAY_LOGIN=
IWAY_PASSWORD=
IWAY_IMAGES_URL=

# ------------------------------------------------------------------ Exchange rate (USD -> NGN)
EXCHANGE_RATE_API_KEY=
# "false" disables the scheduled rate refresh
EXCHANGE_RATE_SYNC_ENABLED=true

# ------------------------------------------------------------------ RateHawk / ETG (hotels)
# Sandbox: https://api-sandbox.ratehawk.com/api   Production: https://api.ratehawk.com/api
RATEHAWK_API_URL=https://api-sandbox.ratehawk.com/api
RATEHAWK_API_KEY_ID=
RATEHAWK_API_KEY_ACCESS_TOKEN=

# Step 1 - static content sync
# "false" turns off the scheduled content sync
RATEHAWK_SYNC_ENABLED=true
# ISO country codes to sync hotels for (required in production)
RATEHAWK_SYNC_COUNTRIES=US,GB,DE
RATEHAWK_CONTENT_LANGUAGE=en
RATEHAWK_CONTENT_MAX_PER_RUN=100
RATEHAWK_CONTENT_INTERVAL_MS=60000
RATEHAWK_IDS_INTERVAL_MS=60000

# Step 3 - prebook: maximum price increase (0-100 %) accepted; the guest must approve the new price
RATEHAWK_PREBOOK_PRICE_INCREASE_PERCENT=10

# Step 4 - booking
# Fixed corporate contact sent to ETG in "Start booking process" (B2B contracts). Defaults: MAIL_USER / guest phone
RATEHAWK_BOOKING_EMAIL=bookings@holidaywaka.com
RATEHAWK_BOOKING_PHONE=+2348050743775
# Agreed booking cut-off: no final status within it = booking failed (default 600 = 10 minutes)
RATEHAWK_BOOKING_TIMEOUT_SECONDS=600
# How often "Check booking process" is polled (ms, minimum 1000)
RATEHAWK_STATUS_POLL_MS=3000
