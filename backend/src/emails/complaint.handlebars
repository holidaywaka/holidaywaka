<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body style="margin: 0; background: whitesmoke;">
    <div style="font-family: Arial, Helvetica, sans-serif; padding: 1rem 0;">
        <div style="width: 92%; max-width: 36rem; margin: 0 auto; padding: 1.5rem; background: white; border-top: 5px solid #002722;">
            <div style="font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: #8f5442; font-weight: bold;">Guest complaint &middot; {{reference}}</div>
            <h1 style="font-size: 1.15rem; color: #002722; margin: 0.5rem 0 1rem;">{{subject}}</h1>
            <p style="color: #333; line-height: 1.5; margin: 0 0 1rem;">{{intro}}</p>

            <div style="background: #fbf6f1; border-left: 3px solid #c08d77; padding: 0.75rem 1rem; margin-bottom: 1.25rem; white-space: pre-wrap; color: #222; line-height: 1.5;">{{guestMessage}}</div>

            <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                <tbody>
                    {{#each facts}}
                    <tr>
                        <td style="text-align: left; padding: 0.4rem 0.5rem 0.4rem 0; color: #666; border-bottom: 1px solid #eee; vertical-align: top;">{{this.label}}</td>
                        <td style="text-align: right; padding: 0.4rem 0; font-weight: bold; color: #111; border-bottom: 1px solid #eee;">{{this.value}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>

            <p style="color: #888; font-size: 0.8rem; margin-top: 1.25rem;">Sent from the {{MAIL_NAME}} "Manage booking" page. Replying to this email answers the guest directly.</p>
        </div>
    </div>
</body>

</html>
