<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body style="margin: 0;background: whitesmoke;">


    <div style=" font-family: Arial, Helvetica, sans-serif; padding-bottom: 1rem; padding-top: 1rem;">
        <div
            style="width: 90%; max-width: 32rem;margin: 0 auto;text-align: center; padding: 2rem 1rem; background: white; border-top: 5px solid #f7960a;">
            <img src="https://res.cloudinary.com/dyznyextv/image/upload/v1769691325/icon_qzahd9.png" style="display: inline; width: 3rem;" alt="">
            <h1 style="font-size: 1rem; text-transform: capitalize;">Hi {{fullname}},</h1>
            <div style="background-color: whitesmoke;padding: 0.5rem;">
                <div>{{message}}</div>
                <table style="width: 100%;">
                    <tbody>
                        {{#each content}}
                        <tr>
                            <td style="text-align: left; padding: 0.5rem;">{{this.label}}: </td>
                            <td style="font-weight: bold; text-align: right; padding: 0.5rem;">{{this.value}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            <div style="padding: 1rem 0; border-bottom: 1px solid lightgrey;margin-bottom: 1rem;">{{date}}</div>
            <div>
                If you did not request for this, kindly contact {{MAIL_NAME}} support at {{MAIL_USER}} or simply reply
                to this email.</div>
        </div>

    </div>
</body>

</html>