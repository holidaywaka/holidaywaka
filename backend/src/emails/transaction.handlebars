<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{subject}}</title>
</head>

<body style="margin: 0; padding: 0; background: #f2f1ee;">
    <div style="font-family: Arial, Helvetica, sans-serif; color: #1f2933; padding: 24px 12px;">
        <div style="max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 10px; overflow: hidden; border: 1px solid #e4e2dd;">

            <div style="padding: 20px 24px; border-bottom: 1px solid #ecebe7;">
                <img src="https://res.cloudinary.com/dyznyextv/image/upload/v1769691325/icon_qzahd9.png" alt="{{MAIL_NAME}}" style="width: 40px; vertical-align: middle;">
                <span style="font-size: 16px; font-weight: bold; vertical-align: middle; margin-left: 8px;">{{MAIL_NAME}}</span>
            </div>

            <div style="padding: 16px 24px; background: {{banner.background}}; color: {{banner.color}};">
                <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: bold;">{{banner.label}}</div>
                <div style="font-size: 20px; font-weight: bold; margin-top: 4px;">{{title}}</div>
                {{#if reference}}<div style="font-size: 13px; margin-top: 4px;">Reference: <strong>{{reference}}</strong></div>{{/if}}
            </div>

            <div style="padding: 20px 24px;">
                <p style="margin: 0 0 12px; font-size: 15px;">Hi {{fullname}},</p>
                {{#each paragraphs}}
                <p style="margin: 0 0 12px; font-size: 14px; line-height: 1.55; color: #3e4c59;">{{this}}</p>
                {{/each}}

                {{#each sections}}
                <div style="margin-top: 18px;">
                    <div style="font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: #52606d; padding-bottom: 6px; border-bottom: 2px solid #002722;">{{this.title}}</div>
                    <table role="presentation" style="width: 100%; border-collapse: collapse; font-size: 14px;">
                        <tbody>
                            {{#each this.rows}}
                            <tr>
                                <td style="padding: 8px 0; color: #616e7c; vertical-align: top; width: 42%; border-bottom: 1px solid #f0efeb;">{{this.label}}</td>
                                <td style="padding: 8px 0; text-align: right; font-weight: bold; vertical-align: top; border-bottom: 1px solid #f0efeb;">{{this.value}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{/each}}

                {{#if totals}}
                <div style="margin-top: 18px; background: #f7f6f3; border-radius: 8px; padding: 12px 16px;">
                    <table role="presentation" style="width: 100%; border-collapse: collapse; font-size: 14px;">
                        <tbody>
                            {{#each totals.rows}}
                            <tr>
                                <td style="padding: 4px 0; color: #616e7c;">{{this.label}}</td>
                                <td style="padding: 4px 0; text-align: right;">{{this.value}}</td>
                            </tr>
                            {{/each}}
                            <tr>
                                <td style="padding: 8px 0 0; font-weight: bold; font-size: 16px; border-top: 1px solid #e4e2dd;">{{totals.label}}</td>
                                <td style="padding: 8px 0 0; text-align: right; font-weight: bold; font-size: 16px; border-top: 1px solid #e4e2dd;">{{totals.value}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                {{/if}}

                {{#if steps}}
                <div style="margin-top: 18px;">
                    <div style="font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: #52606d; margin-bottom: 6px;">What happens next</div>
                    <ol style="margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.6; color: #3e4c59;">
                        {{#each steps}}<li>{{this}}</li>{{/each}}
                    </ol>
                </div>
                {{/if}}

                {{#if action}}
                <div style="margin-top: 22px; text-align: center;">
                    <a href="{{action.url}}" style="display: inline-block; background: #002722; color: #ffffff; text-decoration: none; padding: 12px 22px; border-radius: 8px; font-weight: bold; font-size: 14px;">{{action.label}}</a>
                </div>
                {{/if}}
            </div>

            <div style="padding: 16px 24px; background: #fafaf8; border-top: 1px solid #ecebe7; font-size: 12px; color: #7b8794; line-height: 1.5;">
                Questions about this {{serviceName}}? Reply to this email or contact {{MAIL_NAME}} support at {{MAIL_USER}}.
                <br>Sent {{sentAt}}.
            </div>
        </div>
    </div>
</body>

</html>
