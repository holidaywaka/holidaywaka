# Holidaywaka web - environment variables
# Copy to .env. Note: the API address is currently chosen from the site's domain in
# app/services/api-base.ts, so these values are not read by the app at the moment.

VITE_LIVE_URL=https://api.holidaywaka.com/api
VITE_DEV_URL=https://apidev.holidaywaka.com/api
VITE_LOCAL_URL=http://localhost:8002/api
# Feature flag for airport transfers
VITE_TRANSFER_FEATURE=true

# Public site address used for canonical links, Open Graph URLs and JSON-LD (no trailing slash)
VITE_SITE_URL=https://holidaywaka.com
